<sml:AggregateProcess xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:sml="http://www.opengis.net/sensorml/2.0"
                      xmlns:swe="http://www.opengis.net/swe/2.0" xmlns:gml="http://www.opengis.net/gml/3.2"
                      xmlns:gco="http://www.isotc211.org/2005/gco" xmlns:gmd="http://www.isotc211.org/2005/gmd"
                      gml:id="CHAIN1">
    <gml:identifier codeSpace="uid">0c58ed65-e63d-4d1e-9ef0-b7db0be3685c</gml:identifier>
    <sml:outputs>
        <sml:OutputList>
            <sml:output name="camOutput_RGB">
                <swe:DataStream>
                    <swe:elementType>
                        <swe:DataRecord definition="http://sensorml.com/ont/swe/property/VideoFrame">
                            <swe:label>Detected Features</swe:label>
                            <swe:description>Processed image frames displaying detected features</swe:description>
                            <swe:field name="time">
                                <swe:Time definition="http://www.opengis.net/def/property/OGC/0/SamplingTime"
                                          referenceFrame="http://www.opengis.net/def/trs/BIPM/0/UTC">
                                    <swe:label>Sampling Time</swe:label>
                                    <swe:uom xlink:href="http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"/>
                                </swe:Time>
                            </swe:field>
                            <swe:field name="width">
                                <swe:Count id="IMG_WIDTH" definition="http://sensorml.com/ont/swe/property/GridWidth"
                                           axisID="X">
                                    <swe:label>Frame Width</swe:label>
                                </swe:Count>
                            </swe:field>
                            <swe:field name="height">
                                <swe:Count id="IMG_HEIGHT" definition="http://sensorml.com/ont/swe/property/GridWidth"
                                           axisID="Y">
                                    <swe:label>Frame Height</swe:label>
                                </swe:Count>
                            </swe:field>
                            <swe:field name="img">
                                <swe:DataArray definition="http://sensorml.com/ont/swe/property/RasterImage">
                                    <swe:elementCount xlink:href="#IMG_HEIGHT"/>
                                    <swe:elementType name="row">
                                        <swe:DataArray>
                                            <swe:elementCount xlink:href="#IMG_WIDTH"/>
                                            <swe:elementType name="pixel">
                                                <swe:DataRecord>
                                                    <swe:field name="red">
                                                        <swe:Count
                                                                definition="http://sensorml.com/ont/swe/property/RedChannel"/>
                                                    </swe:field>
                                                    <swe:field name="green">
                                                        <swe:Count
                                                                definition="http://sensorml.com/ont/swe/property/GreenChannel"/>
                                                    </swe:field>
                                                    <swe:field name="blue">
                                                        <swe:Count
                                                                definition="http://sensorml.com/ont/swe/property/BlueChannel"/>
                                                    </swe:field>
                                                </swe:DataRecord>
                                            </swe:elementType>
                                        </swe:DataArray>
                                    </swe:elementType>
                                </swe:DataArray>
                            </swe:field>
                        </swe:DataRecord>
                    </swe:elementType>
                    <swe:encoding>
                        <swe:BinaryEncoding byteOrder="bigEndian" byteEncoding="raw">
                            <swe:member>
                                <swe:Component ref="/time" dataType="http://www.opengis.net/def/dataType/OGC/0/double"/>
                            </swe:member>
                            <swe:member>
                                <swe:Component ref="/width"
                                               dataType="http://www.opengis.net/def/dataType/OGC/0/signedInt"/>
                            </swe:member>
                            <swe:member>
                                <swe:Component ref="/height"
                                               dataType="http://www.opengis.net/def/dataType/OGC/0/signedInt"/>
                            </swe:member>
                            <swe:member>
                                <swe:Block ref="/img" compression="jpeg"/>
                            </swe:member>
                        </swe:BinaryEncoding>
                    </swe:encoding>
                </swe:DataStream>
            </sml:output>
            <sml:output name="detectedVehicles">
                <swe:DataRecord>
                    <swe:label>Vehicle Detected</swe:label>
                    <swe:field name="vehicleDetected">
                        <swe:Boolean id="VEHICLE_DETECTED">
                            <swe:label>Vehicle Detected</swe:label>
                        </swe:Boolean>
                    </swe:field>
                    <swe:field name="foiId">
                        <swe:Count id="FOI_ID">
                            <swe:label>FOI ID</swe:label>
                        </swe:Count>
                    </swe:field>
                    <swe:field name="bboxStartTime">
                        <swe:Time definition="http://www.opengis.net/def/property/OGC/0/SamplingTime"
                                  referenceFrame="http://www.opengis.net/def/trs/BIPM/0/UTC">
                            <swe:label>Detection Start Time</swe:label>
                            <swe:uom xlink:href="http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"/>
                        </swe:Time>
                    </swe:field>
                    <swe:field name="bboxEndTime">
                        <swe:Time definition="http://www.opengis.net/def/property/OGC/0/SamplingTime"
                                  referenceFrame="http://www.opengis.net/def/trs/BIPM/0/UTC">
                            <swe:label>Detection End Time</swe:label>
                            <swe:uom xlink:href="http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"/>
                        </swe:Time>
                    </swe:field>
                </swe:DataRecord>
            </sml:output>
        </sml:OutputList>
    </sml:outputs>
    <sml:components>
        <sml:ComponentList>
            <sml:component name="source0">
                <sml:SimpleProcess gml:id="P_V4L_INPUT">
                    <gml:identifier codeSpace="uid">urn:osh:sensor:v4l-cam:001</gml:identifier>
                    <sml:typeOf xlink:href="urn:osh:process:datasource:datastream"/>
                    <sml:configuration>
                        <sml:Settings>
                            <sml:setValue ref="parameters/systemUID">urn:osh:sensor:v4l-cam:001</sml:setValue>
                            <sml:setValue ref="parameters/outputName">camOutput_RGB</sml:setValue>
                        </sml:Settings>
                    </sml:configuration>
                </sml:SimpleProcess>
            </sml:component>
            <sml:component name="speed_violation_process">
                <sml:SimpleProcess gml:id="P_SPEED_VIOLATION">
                    <sml:typeOf xlink:href="urn:osh:process:opencv:SpeedViolationDetection"/>
                    <sml:configuration>
                        <sml:Settings>
                            <sml:setValue ref="inputs/imageFrame/width">640</sml:setValue>
                            <sml:setValue ref="inputs/imageFrame/height">480</sml:setValue>
                            <sml:setValue ref="parameters/feature">CARS</sml:setValue>
                            <sml:setValue ref="parameters/thresholdParam">25</sml:setValue>
                        </sml:Settings>
                    </sml:configuration>
                </sml:SimpleProcess>
            </sml:component>
            <sml:component name="ops241a">
                <sml:SimpleProcess gml:id="P_OPS241A_INPUT">
                    <gml:identifier codeSpace="uid">osh:OPS241A:001</gml:identifier>
                    <sml:typeOf xlink:href="urn:osh:process:datasource:datastream"/>
                    <sml:configuration>
                        <sml:Settings>
                            <sml:setValue ref="parameters/systemUID">osh:OPS241A:001</sml:setValue>
                            <sml:setValue ref="parameters/outputName">OPS241A</sml:setValue>
                        </sml:Settings>
                    </sml:configuration>
                </sml:SimpleProcess>
            </sml:component>
        </sml:ComponentList>
    </sml:components>
    <sml:connections>
        <sml:ConnectionList>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/source0/outputs/camOutput_RGB/img"/>
                    <sml:destination ref="components/speed_violation_process/inputs/imageFrame/img"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/source0/outputs/camOutput_RGB/time"/>
                    <sml:destination ref="components/speed_violation_process/inputs/imageFrame/time"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/ops241a/outputs/OPS241A/timestamp"/>
                    <sml:destination ref="components/speed_violation_process/inputs/velocityInput/time"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/ops241a/outputs/OPS241A/detectionSpeed"/>
                    <sml:destination ref="components/speed_violation_process/inputs/velocityInput/velocity"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/speed_violation_process/outputs/detectedVehicles/vehicleDetected"/>
                    <sml:destination ref="outputs/detectedVehicles/vehicleDetected"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/speed_violation_process/outputs/detectedVehicles/foiId"/>
                    <sml:destination ref="outputs/detectedVehicles/foiId"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/speed_violation_process/outputs/detectedVehicles/bboxStartTime"/>
                    <sml:destination ref="outputs/detectedVehicles/bboxStartTime"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/speed_violation_process/outputs/detectedVehicles/bboxEndTime"/>
                    <sml:destination ref="outputs/detectedVehicles/bboxEndTime"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/speed_violation_process/outputs/speedViolationCapture/captureTime"/>
                    <sml:destination ref="outputs/camOutput_RGB/time"/>
                </sml:Link>
            </sml:connection>
            <sml:connection>
                <sml:Link>
                    <sml:source ref="components/speed_violation_process/outputs/speedViolationCapture/captureImage"/>
                    <sml:destination ref="outputs/camOutput_RGB/img"/>
                </sml:Link>
            </sml:connection>
        </sml:ConnectionList>
    </sml:connections>
</sml:AggregateProcess>
